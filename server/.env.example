DATABASE_URL="mysql://user:password@localhost:3306/crm_hudco"
JWT_SECRET="replace-with-a-long-random-string"

# Email notifications (optional). Leave SMTP_HOST out to switch email off.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="notifications@example.com"
SMTP_PASS="your-smtp-password"
MAIL_FROM="CRM <notifications@example.com>"
APP_URL="http://localhost:5173"

# Optional: how many months of chat history to keep (default 6)
CHAT_RETENTION_MONTHS="6"